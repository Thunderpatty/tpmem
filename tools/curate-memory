#!/usr/bin/env bash
# curate-memory — snapshot helper for the curator.
#
# NOTE: This tool NO LONGER spawns a headless Claude session. Curation itself
# now runs inside a Claude Code session:
#   • Manually: open Claude Code and say "run curate-memory" (invokes the
#     curate-memory skill in your live session).
#   • Scheduled: run the tpmem daemon (tpmem-companion-engine), which wakes a
#     persistent curator agent on a schedule by injecting the curation prompt
#     into its tmux session. No `claude -p`.
#
# All this wrapper does is take a timestamped backup of PERSISTENT.md and keep
# the last 7. The curate-memory skill runs this (or the equivalent) as its
# first step, so the snapshot happens whenever curation runs — but you can also
# run it standalone before hand-editing PERSISTENT.md.
#
# Usage:
#   curate-memory            # snapshot PERSISTENT.md, keep last 7

set -euo pipefail

TPMEM_DIR="${TPMEM_DIR:-${HOME}/.tpmem}"
LOG="${TPMEM_DIR}/curator-cron.log"

timestamp() { date -Iseconds; }
log() { echo "[$(timestamp)] $*" | tee -a "$LOG"; }

# Find PERSISTENT.md — it lives in the Claude Code project memory dir.
# Default layout: ~/.claude/projects/-home-$USER/memory/PERSISTENT.md
# Override via PERSISTENT_MD if your project dir is non-standard.
PROJECT_MEM_DIR="${HOME}/.claude/projects/-home-${USER}/memory"
PERSISTENT="${PERSISTENT_MD:-${PROJECT_MEM_DIR}/PERSISTENT.md}"
BACKUP_DIR="${TPMEM_DIR}/persistent-backups"

if [[ -f "$PERSISTENT" ]]; then
    mkdir -p "$BACKUP_DIR"
    cp -p "$PERSISTENT" "${BACKUP_DIR}/PERSISTENT-$(date +%Y-%m-%d-%H%M%S).md"
    ls -1t "${BACKUP_DIR}"/PERSISTENT-*.md 2>/dev/null | tail -n +8 | xargs -r rm -f
    log "snapshotted PERSISTENT.md to ${BACKUP_DIR} (keeping last 7)"
else
    log "note: PERSISTENT.md not found at $PERSISTENT — nothing to snapshot yet"
fi

cat <<'EOF'

curate-memory: snapshot done.

Curation itself runs IN-SESSION, not from this wrapper:
  • Manual   → open Claude Code and say "run curate-memory".
  • Scheduled → run the tpmem daemon (tpmem-companion-engine); it wakes a
               persistent curator agent via tmux-inject on a schedule.
EOF
